APP_NAME="E-Rapor RA Al-Musyafallahi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://e-raport.almusyafallahi.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================
# DATABASE (MySQL / Railway)
# =====================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erapor_db
DB_USERNAME=root
DB_PASSWORD=

GEMINI_API_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@almusyafallahi.id"
MAIL_FROM_NAME="${APP_NAME}"

# =====================
# GOOGLE OAUTH CREDENTIALS
# =====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://e-raport.almusyafallahi.id/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
